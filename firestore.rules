rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasUserRole(roleName) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == roleName;
    }

    match /users/{uid} {
      allow read: if isOwnUser(uid) || hasUserRole('admin');
      allow create: if isOwnUser(uid)
        && request.resource.data.id == uid
        && request.resource.data.role == 'user';
      allow update: if isOwnUser(uid)
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /locations/{locationId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.status in ['candidate', 'unknown'];
      allow update, delete: if false;

      match /broadcasts/{broadcastId} {
        allow read: if signedIn();
        allow create, update: if hasUserRole('admin')
          && request.resource.data.locationId == locationId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;
        allow delete: if hasUserRole('admin');
      }
    }

    match /verificationRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.status == 'pending';
      allow update: if hasUserRole('admin')
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if hasUserRole('admin');
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /favorites/{favoriteId} {
      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
